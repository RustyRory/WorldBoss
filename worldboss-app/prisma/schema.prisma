generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Identité Discord — existe indépendamment des serveurs
model User {
  id         String   @id // Discord user ID
  username   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  characters Character[]
}

// Personnage d'un joueur sur un serveur Discord spécifique
model Character {
  id                    Int      @id @default(autoincrement())
  userId                String
  guildId               String
  name                  String   @default("")
  race                  String   @default("humain")
  gender                String   @default("male")
  level                 Int      @default(1)
  rank                  Int      @default(0)
  xp                    Int      @default(0)
  gold                  Int      @default(0)
  hp                    Int      @default(120)
  hpUpdatedAt           DateTime @default(now())
  actionPoints          Int      @default(10)
  actionPointsUpdatedAt DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  items           CharacterItem[]
  loadout         Loadout?
  companion       Companion?
  servant         Servant?
  arenaProfile    ArenaProfile?
  dungeonRuns     DungeonRun[]
  marketListings      MarketListing[]    @relation("MarketSeller")
  marketBids          MarketListing[]    @relation("MarketBidder")
  primeParticipations PrimeParticipant[]

  @@unique([userId, guildId])
}

model Item {
  id            String @id // e.g. 'sword_rusty'
  name          String
  type          String // weapon | shield | armor | helmet | gloves | boots | belt | amulet | ring | consumable
  rarity        String // common | rare | epic | legendary
  statsJson     Json   @default("{}")
  skillJson     Json?
  effectJson    Json?
  price         Int    @default(0)
  levelRequired Int    @default(1)

  characterItems CharacterItem[]
}

model CharacterItem {
  id          Int      @id @default(autoincrement())
  characterId Int
  itemId      String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])

  @@unique([characterId, itemId])
}

model Loadout {
  id          Int     @id @default(autoincrement())
  characterId Int     @unique
  weaponId    String?
  shieldId    String?
  armorId     String? // armure de torse
  helmetId    String?
  glovesId    String?
  bootsId     String?
  beltId      String?
  amuletId    String?
  ring1Id     String?
  ring2Id     String?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Compagnon de combat — un seul par personnage pour l'instant, acheté chez le dresseur.
// Progresse uniquement par XP passive (gagnée en donjon comme le joueur), pas d'entraînement actif.
model Companion {
  id          Int      @id @default(autoincrement())
  characterId Int      @unique
  speciesId   String
  name        String
  level       Int      @default(1)
  xp          Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Serviteur — un seul par personnage, recruté chez le recruteur.
// Assigné à une tâche économique (mine_gold) ou d'entraînement (train_combat) qui se
// résout dans le temps via une file BullMQ (voir servant.service.js). Ne combat que
// lorsqu'il est "idle" (pas occupé par une tâche).
model Servant {
  id            Int       @id @default(autoincrement())
  characterId   Int       @unique
  name          String
  level         Int       @default(1)
  loyalty       Int       @default(0)
  task          String    @default("idle") // idle | mine_gold | train_combat
  taskStartedAt DateTime?
  taskEndsAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model DungeonRun {
  id          Int      @id @default(autoincrement())
  characterId Int
  chapter     Int
  status      String   @default("active") // active | completed | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// ── Guildes (serveurs Discord) ────────────────────────────────────────────────
// NB: "Guild" ici désigne un serveur Discord, PAS une guilde de joueurs.
// Pour une guilde/alliance formée par des joueurs, voir le modèle Alliance (à venir).

model Guild {
  id        String   @id // Discord guild ID
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels      GuildChannels?
  characters    Character[]
  merchantShop  MerchantShop?
  city          City?
}

model GuildChannels {
  id               Int     @id @default(autoincrement())
  guildId          String  @unique
  categoryId       String?
  infoChannelId    String?
  generalChannelId String?
  dungeonChannelId String?
  marketChannelId  String?
  arenaChannelId   String?
  cityChannelId    String?

  guild            Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model MerchantShop {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  gold      Int      @default(5000)
  stockJson String   @default("[]")
  messageId String?
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model PrimeRun {
  id          Int      @id @default(autoincrement())
  guildId     String
  primeId     Int
  leaderId    Int
  status      String   @default("recruiting") // recruiting | active | completed | failed
  messageId   String?
  channelId   String?
  roomIndex   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants PrimeParticipant[]
}

model PrimeParticipant {
  id          Int      @id @default(autoincrement())
  primeRunId  Int
  characterId Int
  isLeader    Boolean  @default(false)
  createdAt   DateTime @default(now())

  primeRun    PrimeRun  @relation(fields: [primeRunId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([primeRunId, characterId])
}

// ── Arène PvP (Phase 1 : 1v1 classée ou amicale, même serveur) ────────────────

model ArenaProfile {
  id          Int       @id @default(autoincrement())
  characterId Int       @unique
  elo         Int       @default(1000)
  wins        Int       @default(0)
  losses      Int       @default(0)
  lastMatchAt DateTime?

  character  Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  matchesAsA ArenaMatch[] @relation("ArenaMatchA")
  matchesAsB ArenaMatch[] @relation("ArenaMatchB")
}

model ArenaMatch {
  id           Int      @id @default(autoincrement())
  guildId      String
  characterAId Int
  characterBId Int
  winnerId     Int?
  ranked       Boolean  @default(true)
  eloDeltaA    Int      @default(0)
  eloDeltaB    Int      @default(0)
  logJson      Json     @default("[]")
  createdAt    DateTime @default(now())

  characterA ArenaProfile @relation("ArenaMatchA", fields: [characterAId], references: [characterId], onDelete: Cascade)
  characterB ArenaProfile @relation("ArenaMatchB", fields: [characterBId], references: [characterId], onDelete: Cascade)
}

// ── Cité commune (une par serveur Discord, alimentée par les dons des joueurs) ─

model City {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  wood      Int      @default(0)
  stone     Int      @default(0)
  iron      Int      @default(0)
  food      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild           Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  buildings       Building[]
  constructionJob ConstructionJob?
}

model Building {
  id        Int      @id @default(autoincrement())
  cityId    Int
  type      String
  level     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, type])
}

// @unique sur cityId : une seule construction active à la fois par cité (décision actée).
model ConstructionJob {
  id           Int      @id @default(autoincrement())
  cityId       Int      @unique
  buildingType String
  targetLevel  Int
  startedAt    DateTime @default(now())
  completesAt  DateTime

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model MarketListing {
  id          Int       @id @default(autoincrement())
  guildId     String
  sellerId    Int
  itemId      String
  quantity    Int       @default(1)
  type        String    // "auction" | "merchant"
  startPrice  Int
  buyoutPrice Int?
  currentBid  Int?
  bidderId    Int?
  messageId   String?   // Discord message ID pour éditer l'embed
  status      String    @default("active") // active | sold | expired | cancelled
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller      Character  @relation("MarketSeller", fields: [sellerId], references: [id])
  bidder      Character? @relation("MarketBidder", fields: [bidderId], references: [id])
}
